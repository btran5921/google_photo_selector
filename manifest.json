{
  "manifest_version": 3,
  "name": "Google Photos Batch Trash Assistant",
  "version": "1.0.0",
  "description": "Select all or batch photos in Google Photos with one click and move them to Trash.",
  "permissions": ["sidePanel"],
  "host_permissions": ["https://photos.google.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Google Photos Batch Trash Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://photos.google.com/*"],
      "js": ["photos-content.js"]
    }
  ]
}
